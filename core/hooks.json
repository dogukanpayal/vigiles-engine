{
    "sentinel-guard": {
        "PreToolUse": [
            {
                "matcher": "run_command|write_file|edit_file|ask_question|invoke_subagent|read_file",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -ExecutionPolicy Bypass -NoProfile -File %USERPROFILE%\\.gemini\\config\\scripts\\sentinel_guard.ps1",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "live-mission-control": {
        "PreInvocation": [
            {
                "type": "command",
                "command": "powershell -ExecutionPolicy Bypass -NoProfile -File %USERPROFILE%\\.gemini\\config\\scripts\\ensure_live_mission_control.ps1",
                "timeout": 15
            }
        ],
        "Stop": [
            {
                "type": "command",
                "command": "powershell -ExecutionPolicy Bypass -NoProfile -File %USERPROFILE%\\.gemini\\config\\scripts\\on_mission_complete.ps1",
                "timeout": 10
            }
        ]
    }
}
