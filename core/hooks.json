{
    "sentinel-guard": {
        "PreToolUse": [
            {
                "matcher": "run_command|write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|delete_file|ask_question|invoke_subagent|read_file",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -ExecutionPolicy Bypass -NoProfile -File %USERPROFILE%\\.gemini\\config\\scripts\\sentinel_guard.ps1",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "live-mission-control": {
        "PreInvocation": [
            {
                "type": "command",
                "command": "powershell -ExecutionPolicy Bypass -NoProfile -File %USERPROFILE%\\.gemini\\config\\scripts\\ensure_live_mission_control.ps1",
                "timeout": 15
            }
        ],
        "Stop": [
            {
                "type": "command",
                "command": "powershell -ExecutionPolicy Bypass -NoProfile -File %USERPROFILE%\\.gemini\\config\\scripts\\on_mission_complete.ps1",
                "timeout": 10
            }
        ]
    },
    "think-readonly-guard": {
        "PreInvocation": [
            {
                "type": "command",
                "command": "powershell -ExecutionPolicy Bypass -NoProfile -File %USERPROFILE%\\.gemini\\config\\scripts\\think_readonly_guard.ps1",
                "timeout": 10
            }
        ],
        "PreToolUse": [
            {
                "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|delete_file|apply_patch|notebook_edit|run_command|invoke_subagent|define_subagent|run_workflow|swarm",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -ExecutionPolicy Bypass -NoProfile -File %USERPROFILE%\\.gemini\\config\\scripts\\think_readonly_guard.ps1",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "session-file-ledger": {
        "PreToolUse": [
            {
                "matcher": "run_command",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -ExecutionPolicy Bypass -NoProfile -File %USERPROFILE%\\.gemini\\config\\scripts\\session_file_ledger.ps1",
                        "timeout": 10
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "write_file|edit_file|write_to_file|replace_file_content|multi_replace_file_content|delete_file|apply_patch|notebook_edit|run_command",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -ExecutionPolicy Bypass -NoProfile -File %USERPROFILE%\\.gemini\\config\\scripts\\session_file_ledger.ps1",
                        "timeout": 10
                    }
                ]
            }
        ]
    },
    "command-watchdog": {
        "PreToolUse": [
            {
                "matcher": "run_command",
                "hooks": [
                    {
                        "type": "command",
                        "command": "powershell -ExecutionPolicy Bypass -NoProfile -File %USERPROFILE%\\.gemini\\config\\scripts\\command_watchdog.ps1",
                        "timeout": 10
                    }
                ]
            }
        ]
    }
